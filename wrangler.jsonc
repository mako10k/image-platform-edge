{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-platform-oauth-edge-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0
  },
  "limits": {
    "cpu_ms": 50
  },
  "vars": {
    "MAX_REQUEST_BYTES": "16777216"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
