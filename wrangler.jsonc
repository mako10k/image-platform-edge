{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-platform-oauth-edge-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0
  },
  "limits": {
    "cpu_ms": 50
  },
  "routes": [
    {
      "pattern": "api-staging.image.mk10.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "MAX_REQUEST_BYTES": "16777216",
    "WORKOS_ISSUER": "https://daring-haven-18-staging.authkit.app",
    "WORKOS_AUDIENCE": "client_01M0F65BD7G48KBFXZ2HT2NQFM",
    "WORKOS_JWKS_URL": "https://daring-haven-18-staging.authkit.app/oauth2/jwks"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
